{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1280px" },
    "color": {
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Fond" },
        { "slug": "contrast", "color": "#111111", "name": "Texte" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" }
  },
  "templateParts": [
    { "name": "header", "area": "header", "title": "En-tête" },
    { "name": "footer", "area": "footer", "title": "Pied de page" }
  ]
}
